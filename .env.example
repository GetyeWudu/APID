# Database (PostgreSQL)
POSTGRES_DB=apid_db
POSTGRES_USER=apid_user
POSTGRES_PASSWORD=apid_local_password
POSTGRES_PORT=5432

# Cache (Redis)
REDIS_PORT=6379

# Backend API
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Security (use a strong 32+ character secret in production)
JWT_SECRET=apid-local-dev-jwt-secret-key-change-in-production-2026
JWT_EXPIRATION_MS=86400000

# CORS (local React + Vite frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# File Storage
APID_STORAGE_PATH=/app/uploads

# Daily.co Live Video Integration
DAILY_API_BASE_URL=https://api.daily.co/v1
DAILY_API_KEY=replace-with-your-daily-co-api-key
DAILY_WEBHOOK_SECRET=replace-with-your-daily-webhook-secret

