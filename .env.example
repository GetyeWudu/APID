# Database (PostgreSQL)
POSTGRES_DB=apid_db
POSTGRES_USER=apid_user
POSTGRES_PASSWORD=apid_local_password
POSTGRES_PORT=5432

# Cache (Redis)
REDIS_PORT=6379

# Backend API
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Security (use a strong 32+ character secret in production)
JWT_SECRET=apid-local-dev-jwt-secret-key-change-in-production-2026
JWT_EXPIRATION_MS=86400000

# CORS (local React + Vite frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# File Storage
APID_STORAGE_PATH=/app/uploads

# Real-Time Video Communication (LiveKit Server on Windows 11 host)
MEETING_PROVIDER=livekit
LIVEKIT_API_URL=http://10.9.36.155:7880
LIVEKIT_PUBLIC_URL=wss://apid-livekit.home.arpa
LIVEKIT_API_KEY=APIDLocalKey
LIVEKIT_API_SECRET=replace-with-your-livekit-secret
LIVEKIT_TOKEN_TTL=7200

# Local AI Infrastructure (Ollama + Qwen3:8B on Windows 11 host)
AI_ENABLED=true
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://10.9.36.155:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120

# Active Directory Domain Services (AD DS) - Windows Server 2025 DC at 10.9.82.23
APID_LDAP_ENABLED=true
APID_LDAP_URL=ldaps://apid-dc01.apid.test:636
APID_LDAP_BASE_DN=DC=apid,DC=test
APID_LDAP_DOMAIN=apid.test
APID_LDAP_USER_SEARCH_BASE=OU=APID,DC=apid,DC=test
APID_LDAP_BIND_DN=CN=APID LDAP Service Account,OU=Service Accounts,OU=APID,DC=apid,DC=test
APID_LDAP_BIND_PASSWORD=
APID_LDAP_TIMEOUT_MS=5000

# Mentor recommendations use the instruction-tuned local model
MENTORING_AI_OLLAMA_MODEL=qwen2.5:14b


# Ollama mentoring AI
MENTORING_AI_OLLAMA_CHAT_URL=http://localhost:11434/api/chat

# PaddleOCR
PADDLE_OCR_PORT=8001
PADDLE_OCR_LANG=en
